define clamp(new var, new min, new max) {
    if (var < min) {
        return min;
    };

    if (var > max) {
        return max;
    };

    return var;
}

define next_color(color, new color_count) {
    if (color + 1 < color_count) {
        color = color + 1;
        return color;
    } else {
        return 0;
    };
}
